{
  "name": "@genius/mcp-organograma",
  "version": "0.1.0",
  "description": "Servidor MCP do compilador de organograma: a Lei 1 (nada existe sem o organograma) disponível para Hermes, Claude Code, Codex e qualquer cliente MCP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
