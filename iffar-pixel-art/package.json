{
  "name": "iffar-pixel-art",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Centro operacional espacial do IFFar: tarefas reais, execução de CLIs e evidências auditáveis.",
  "scripts": {
    "dev": "node server/index.mjs",
    "web": "vite",
    "build": "vite build",
    "test": "node --test server/test/*.test.mjs",
    "generate:agents": "node scripts/generate-agent-catalog.mjs",
    "runbook": "node scripts/execute-agent-runbook.mjs",
    "check": "npm run test && npm run build",
    "generate:skills": "node scripts/generate-hermes-skills.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.1"
  },
  "devDependencies": {}
}
